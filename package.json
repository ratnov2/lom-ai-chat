{
  "name": "lom-ai-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint src e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "standalone": "npm run build && node scripts/standalone.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.44.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "3.0.4"
  }
}
